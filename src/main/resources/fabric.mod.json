{
  "schemaVersion": 1,
  "id": "blockoscope_steamvr",
  "version": "0.3.2-alpha",
  "name": "Blockoscope SteamVR",
  "description": "Renders Minecraft in stereoscopic 3D straight onto a virtual screen in SteamVR, at full resolution per eye, with no monitor or VR mod needed.",
  "authors": [
    "Nick Y"
  ],
  "contact": {
    "sources": "https://github.com/nick-yoderia/blockoscope-steamvr",
    "issues": "https://github.com/nick-yoderia/blockoscope-steamvr/issues"
  },
  "license": "MIT",
  "icon": "assets/blockoscope_steamvr/icon.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "nzy.blockoscope.steamvr.StereoModMenu"
    ]
  },
  "mixins": [
    "blockoscope_steamvr.mixins.json",
    "blockoscope_steamvr.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "breaks": {
    "vivecraft": "*",
    "blockoscope_sbs": "*",
    "parallax_theater": "*",
    "parallax_screen": "*"
  },
  "recommends": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
