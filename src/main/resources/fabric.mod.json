{
  "schemaVersion": 1,
  "id": "parallax_theater",
  "version": "0.1.5-alpha",
  "name": "Parallax Theater",
  "description": "Renders Minecraft in half side-by-side stereoscopic 3D for viewing on a virtual screen, with no VR mod needed.",
  "authors": [
    "Nick Y"
  ],
  "contact": {
    "sources": "https://github.com/nick-yoderia/parallax-theater",
    "issues": "https://github.com/nick-yoderia/parallax-theater/issues"
  },
  "license": "MIT",
  "icon": "assets/parallax_theater/icon.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "nzy.parallaxtheater.StereoModMenu"
    ]
  },
  "mixins": [
    "parallaxtheater.mixins.json",
    "parallaxtheater.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~26.2"
  },
  "breaks": {
    "vivecraft": "*"
  },
  "recommends": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
